generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VOLUNTEER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum DonorStatus {
  AVAILABLE
  UNAVAILABLE
  INACTIVE
}

enum RequestStatus {
  PENDING
  MATCHING
  FULFILLED
  CANCELLED
}

enum RequestUrgency {
  NORMAL
  URGENT
  CRITICAL
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  NO_RESPONSE
}

enum WeightCategory {
  ABOVE_45_KG
  BELOW_45_KG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VOLUNTEER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recordedContacts DonorContact[]
  recordedResponses DonorResponse[]
}

model Student {
  id String @id @default(cuid())

  name       String
  department String?
  age        Int?

  bloodGroup BloodGroup?

  phone    String?
  address  String?

  weightCategory WeightCategory?
  gender         Gender?
  semester       Int?

  willingToDonate Boolean @default(true)
  isDonor         Boolean @default(true)

  donorStatus DonorStatus @default(AVAILABLE)

  registeredAt   DateTime?
  lastDonationAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchedRequests BloodRequest[] @relation("BloodRequestMatchedDonors")

  @@index([bloodGroup])
  @@index([donorStatus])
  @@index([phone])
  @@index([department])
}

model BloodRequest {
  id String @id @default(cuid())

  patientName String
  hospital    String?
  location    String?
  bystanderName  String
  bystanderPhone String

  bloodGroup BloodGroup
  units      Int        @default(1)

  requiredAt DateTime?
  urgency    RequestUrgency @default(NORMAL)
  notes      String?

  matchedDonors Student[] @relation("BloodRequestMatchedDonors")

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bloodGroup])
  @@index([status])
}