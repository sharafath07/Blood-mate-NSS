generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VOLUNTEER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum DonorStatus {
  AVAILABLE
  UNAVAILABLE
  INACTIVE
}

enum RequestStatus {
  PENDING
  MATCHING
  FULFILLED
  CANCELLED
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  NO_RESPONSE
}

enum WeightCategory {
  ABOVE_45_KG
  BELOW_45_KG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VOLUNTEER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id String @id @default(cuid())

  name       String
  department String?
  age        Int?

  bloodGroup BloodGroup?

  phone    String?
  whatsapp String?
  address  String?

  weightCategory WeightCategory?
  gender         Gender?
  academicYear   String?

  willingToDonate Boolean @default(false)
  isDonor         Boolean @default(false)

  donorStatus DonorStatus @default(INACTIVE)

  registeredAt   DateTime?
  lastDonationAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bloodRequests  BloodRequest[]
  donorResponses DonorResponse[]

  @@index([bloodGroup])
  @@index([donorStatus])
  @@index([phone])
  @@index([whatsapp])
  @@index([department])
}

model BloodRequest {
  id String @id @default(cuid())

  patientName String
  hospital    String?
  location    String?

  bloodGroup BloodGroup
  units      Int        @default(1)

  requiredAt DateTime?

  status RequestStatus @default(PENDING)

  requesterId String
  requester   Student @relation(fields: [requesterId], references: [id])

  responses DonorResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bloodGroup])
  @@index([status])
}

model DonorResponse {
  id String @id @default(cuid())

  requestId String
  donorId   String

  status ResponseStatus @default(PENDING)

  respondedAt DateTime?

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor   Student      @relation(fields: [donorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, donorId])
  @@index([donorId])
  @@index([status])
}
